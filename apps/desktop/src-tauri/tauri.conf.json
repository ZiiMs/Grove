{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Grove",
  "version": "0.3.0",
  "identifier": "dev.grove.app",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Grove",
        "width": 1280,
        "height": 840,
        "minWidth": 360,
        "minHeight": 600,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI4Q0YxOTc3QzlDODkwNDkKUldSSmtNakpkeG5QS0ZZNWtJUExEMGJhcG9MTUFoUU1mMFo5VjBwQ0NLN2J6WHFMYTNKNlQwL0sK",
      "endpoints": [
        "https://github.com/ZiiMs/Grove/releases/latest/download/latest.json"
      ]
    }
  }
}
