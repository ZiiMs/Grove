{
  "name": "grove",
  "version": "0.1.0",
  "private": true,
  "description": "One desktop home for every AI coding harness",
  "workspaces": ["apps/desktop", "packages/contract", "sidecar"],
  "scripts": {
    "dev": "npm run dev -w @grove/desktop",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "tauri": "npm run tauri -w @grove/desktop"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
